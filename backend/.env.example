# ─── PostgreSQL (Supabase) ───
# Replace with your Supabase pooled connection string.
DATABASE_URL=jdbc:postgresql://localhost:5432/transitops
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ─── JWT ───
# 256-bit secret — generate with: openssl rand -base64 32
JWT_SECRET=transitops_super_secret_jwt_key_change_in_production_2026

# ─── Spring profile ───
# Set to `dev` to auto-seed demo users on startup.
SPRING_PROFILES_ACTIVE=dev
